#!/usr/bin/env python3
"""Report which AFTERLOCK execution profiles this host supports. Changes nothing."""
import shutil
import subprocess
import sys

PROFILES = {
    "replay": ["python>=3.11"],
    "portable": ["python>=3.11", "go", "node"],
    "integration": ["python>=3.11", "docker-daemon"],
    "live-lab": ["python>=3.11", "docker-daemon", "kind", "kubectl"],
}


def probe(cmd: list[str]) -> tuple[bool, str]:
    if shutil.which(cmd[0]) is None:
        return False, "not installed"
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=15)
    except (OSError, subprocess.TimeoutExpired) as exc:
        return False, str(exc)
    out = (p.stdout or p.stderr).strip().splitlines()
    return p.returncode == 0, out[0][:80] if out else ""


def main() -> int:
    profile = "replay"
    if "--profile" in sys.argv:
        profile = sys.argv[sys.argv.index("--profile") + 1]
    if profile not in PROFILES:
        print(f"unknown profile {profile}; choose from {sorted(PROFILES)}")
        return 2
    checks = {
        "python>=3.11": (sys.version_info >= (3, 11), sys.version.split()[0]),
        "go": probe(["go", "version"]),
        "node": probe(["node", "--version"]),
        "docker-daemon": probe(["docker", "info", "--format", "{{.ServerVersion}}"]),
        "kind": probe(["kind", "version"]),
        "kubectl": probe(["kubectl", "version", "--client"]),
    }
    ok = True
    for name, (good, detail) in checks.items():
        needed = name in PROFILES[profile]
        ok &= good or not needed
        mark = "ok  " if good else ("MISS" if needed else "--  ")
        print(f"[{mark}] {name:14} {detail}")
    supported = [p for p, reqs in PROFILES.items() if all(checks[r][0] for r in reqs)]
    print(f"\nsupported profiles: {', '.join(supported) or 'none'}")
    print(f"requested profile '{profile}': {'available' if ok else 'NOT available (checks depending on it are blocked, not passed)'}")
    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main())
