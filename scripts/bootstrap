#!/usr/bin/env sh
# Create a local virtual environment with pinned tooling. Does not touch system packages.
set -eu
cd "$(dirname "$0")/.."
if command -v uv >/dev/null 2>&1; then
  uv venv .venv
  uv pip install --python .venv -e ".[dev]"
else
  python3 -m venv .venv
  .venv/bin/pip install -e ".[dev]"
fi
echo "ready: . .venv/bin/activate && afterlock capabilities"
