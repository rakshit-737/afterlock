# Comma-separated <token>:<role>:<cluster>[|<cluster>] entries. Tokens must be >= 16 chars.
# Roles: viewer, analyst, lab-operator. Generate tokens with: python -c "import secrets;print(secrets.token_urlsafe(32))"
AFTERLOCK_API_TOKENS=replace-with-a-long-random-token:analyst:lab-local

# Storage. Unset = in-memory (lost on restart; async jobs run inside the API process).
# Set to use PostgreSQL; run `python -m afterlock_api.migrate` first (compose does this).
# AFTERLOCK_DATABASE_URL=postgresql://afterlock:<password>@postgres:5432/afterlock
# Password for the compose postgres service (compose builds AFTERLOCK_DATABASE_URL from it).
AFTERLOCK_POSTGRES_PASSWORD=replace-with-a-long-random-password
# Worker tuning (optional): AFTERLOCK_WORKER_ID, AFTERLOCK_WORKER_LEASE_SECONDS=30, AFTERLOCK_WORKER_POLL_SECONDS=2
# Tests: point at a DISPOSABLE database to run the PostgreSQL contract tests.
# AFTERLOCK_TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/afterlock_test
